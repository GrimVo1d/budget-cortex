# Copy to .env for `docker compose`. dev-insecure-* values are for local use only;
# settings.prod refuses to start with them.

SECRET_KEY=dev-insecure-change-me
JWT_SIGNING_KEY=dev-insecure-jwt-signing-key-change-me
DEBUG=1

POSTGRES_USER=bc
POSTGRES_PASSWORD=bc
POSTGRES_DB=budget_cortex
REDIS_PASSWORD=bc

FX_PROVIDER=stub
FX_BASE_CURRENCY=RUB

LOG_LEVEL=INFO
LOG_FORMAT=json

# Published on 127.0.0.1 only.
API_PORT=8000
DB_PORT=5432
