# Copy to .env and adjust. dev-insecure-* placeholders are NOT safe for production.

DJANGO_SETTINGS_MODULE=budget_cortex.settings.dev
SECRET_KEY=dev-insecure-change-me
DEBUG=1
ALLOWED_HOSTS=*

DATABASE_URL=postgres://bc:bc@db:5432/budget_cortex
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SIGNING_KEY=dev-insecure-jwt
FX_PROVIDER=stub
FX_BASE_CURRENCY=RUB

MEDIA_ROOT=/app/media

LOG_LEVEL=INFO
LOG_FORMAT=json

API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
